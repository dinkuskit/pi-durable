{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-pi-durable",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "Pi Durable",
  "description": "Bolt a serverless Pi Durable agent (Cloudflare Worker + Durable Object) next to any EmDash site with BYO subscriptions.",
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/pi-durable/security"
  },
  "repo": "https://github.com/dinkuskit/pi-durable",
  "capabilities": [
    "network:request:unrestricted",
    "schema:read",
    "content:read"
  ],
  "storage": {},
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "Pi Durable Worker connection",
        "description": "Encrypted Pi Durable Worker URL, Pi subscription model, bearer token, and enabled content collections. Managed on the Pi Assistant page."
      }
    },
    "pages": [
      {
        "path": "/pi-durable",
        "label": "Pi Assistant",
        "icon": "sparkles",
        "group": "Pi Durable"
      }
    ],
    "editorPanels": [
      {
        "id": "pi-durable-assistant",
        "title": "Pi Assistant",
        "route": "editor/assistant"
      }
    ]
  }
}
